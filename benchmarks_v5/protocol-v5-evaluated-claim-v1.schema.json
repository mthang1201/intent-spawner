{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol-v5-evaluated-claim-v1.schema.json",
  "title": "Protocol-v5 evaluated thesis claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "claim_id", "research_question", "hypothesis",
    "experiments", "metrics", "statistical_tests", "evidence",
    "evidence_status", "result", "claim_status", "claimable",
    "reason_codes", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "protocol-v5-evaluated-claim-v1.0.0"},
    "claim_id": {"type": "string", "pattern": "^H(?:[1-8]|7F)$"},
    "research_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question"],
      "properties": {"id": {"type": "string"}, "question": {"type": "string"}}
    },
    "hypothesis": {"type": "string"},
    "experiments": {"type": "array", "items": {"type": "string"}},
    "metrics": {"type": "array", "items": {"type": "object"}},
    "statistical_tests": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "evidence_status": {"type": "array", "items": {"type": "object"}},
    "result": {"type": "object"},
    "claim_status": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "NOT_EXECUTED"]},
    "claimable": {"type": "boolean"},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "object"}}
  }
}
