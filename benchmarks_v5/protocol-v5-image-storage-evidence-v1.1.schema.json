{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol-v5-image-storage-evidence-v1.1.schema.json",
  "title": "Protocol-v5 E5 image storage evidence with collector authenticity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_version", "experiment_id", "execution_status",
    "split_stage", "claims_permitted", "measured_at_utc", "catalog",
    "platform", "collector", "measurement_method", "prefixes", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "protocol-v5-image-storage-evidence-v1.1.0"},
    "protocol_version": {"const": "5.0.0"},
    "experiment_id": {"const": "E5"},
    "execution_status": {"enum": ["OBSERVED", "NOT_EXECUTED"]},
    "split_stage": {"enum": ["development", "confirmatory"]},
    "claims_permitted": {"type": "boolean"},
    "measured_at_utc": {"type": "string", "format": "date-time"},
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "file_sha256", "ordered_image_digests"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ordered_image_digests": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": true,
      "required": ["environment_id", "runtime", "operating_system", "architecture"],
      "properties": {
        "environment_id": {"type": "string", "minLength": 1},
        "runtime": {"enum": ["docker", "container_storage", "synthetic_test", "dry_run"]},
        "operating_system": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1}
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "origin", "collector_name", "collector_version",
        "evidence_classification", "raw_observation_count"
      ],
      "properties": {
        "schema_version": {"const": "protocol-v5-storage-collector-v1.0.0"},
        "origin": {
          "enum": [
            "REAL_REGISTRY", "CONTAINER_STORAGE_OBSERVATION",
            "SYNTHETIC_TEST", "DRY_RUN"
          ]
        },
        "collector_name": {"type": "string", "minLength": 1},
        "collector_version": {"type": "string", "minLength": 1},
        "evidence_classification": {
          "enum": ["REAL_OBSERVATION", "NON_OBSERVED_TEST"]
        },
        "raw_observation_count": {"type": "integer", "minimum": 0}
      }
    },
    "measurement_method": {"type": "string", "minLength": 1},
    "prefixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prefix_size", "image_digests", "naive_logical_bytes", "unique_layer_bytes"],
        "properties": {
          "prefix_size": {"type": "integer", "minimum": 1},
          "image_digests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
          "naive_logical_bytes": {"type": "integer", "minimum": 0},
          "unique_layer_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "git_revision", "dataset_sha256", "backend_system_versions",
        "storage_collector_origin"
      ],
      "properties": {
        "git_revision": {"type": "string", "minLength": 1},
        "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "backend_system_versions": {"type": "object"},
        "storage_collector_origin": {
          "enum": [
            "REAL_REGISTRY", "CONTAINER_STORAGE_OBSERVATION",
            "SYNTHETIC_TEST", "DRY_RUN"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"execution_status": {"const": "OBSERVED"}}},
      "then": {
        "properties": {
          "collector": {
            "properties": {
              "origin": {"const": "REAL_REGISTRY"},
              "evidence_classification": {"const": "REAL_OBSERVATION"},
              "raw_observation_count": {"minimum": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "collector": {"properties": {"origin": {"enum": ["CONTAINER_STORAGE_OBSERVATION", "SYNTHETIC_TEST", "DRY_RUN"]}}}
        }
      },
      "then": {
        "properties": {
          "execution_status": {"const": "NOT_EXECUTED"},
          "claims_permitted": {"const": false},
          "collector": {
            "properties": {
              "evidence_classification": {"const": "NON_OBSERVED_TEST"},
              "raw_observation_count": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"claims_permitted": {"const": true}}},
      "then": {
        "properties": {
          "execution_status": {"const": "OBSERVED"},
          "split_stage": {"const": "confirmatory"}
        }
      }
    }
  ]
}
