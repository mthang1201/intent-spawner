{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol-v5-resource-allocation-evidence-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "frozen", "source_id", "cases"],
  "properties": {
    "schema_version": {"const": "protocol-v5-resource-allocation-evidence-v1.0.0"},
    "protocol_version": {"const": "5.0.0"},
    "frozen": {"const": true},
    "source_id": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["allocation_case_id", "workload_instance_id", "workload_fingerprint", "cpu_m", "memory_mib"],
        "properties": {
          "allocation_case_id": {"type": "string", "minLength": 1},
          "workload_instance_id": {"type": "string", "minLength": 1},
          "workload_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "cpu_m": {"type": "integer", "minimum": 1},
          "memory_mib": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
