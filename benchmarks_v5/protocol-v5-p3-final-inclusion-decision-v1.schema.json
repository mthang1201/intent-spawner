{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-spawner.local/schemas/protocol-v5-p3-final-inclusion-decision-v1.schema.json",
  "title": "Protocol-v5 conservative P3 final inclusion decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_version", "decision", "p3_active",
    "claim_eligible", "evidence_classification", "confirmatory_data_used",
    "decision_basis", "source_artifacts", "future_retention_rule"
  ],
  "properties": {
    "schema_version": {"const": "protocol-v5-p3-final-inclusion-decision-v1.0.0"},
    "protocol_version": {"const": "5.0.0"},
    "decision": {"const": "not_retained"},
    "p3_active": {"const": false},
    "claim_eligible": {"const": false},
    "evidence_classification": {"const": "HISTORICAL_FORMATIVE"},
    "confirmatory_data_used": {"const": false},
    "decision_basis": {"type": "string", "minLength": 1},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "future_retention_rule": {"const": "requires_strict_source_recomputed_protocol_v5_development_gate"}
  }
}
