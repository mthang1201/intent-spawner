FROM docker.io/library/python@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db

ARG VCS_REF
ARG SOURCE_DATE_EPOCH
LABEL org.opencontainers.image.revision="${VCS_REF}"
LABEL org.opencontainers.image.source="intent-spawner protocol-v5 independent resource calibration"

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN mkdir -p /app/evaluation_v5/resource /app/benchmarks_v5
COPY cluster_evaluation/container_evaluation_v5_init.py /app/evaluation_v5/__init__.py
COPY evaluation_v5/resource/__init__.py evaluation_v5/resource/models.py evaluation_v5/resource/manifest.py evaluation_v5/resource/workloads.py evaluation_v5/resource/planner.py evaluation_v5/resource/derive.py evaluation_v5/resource/pod_runner.py /app/evaluation_v5/resource/
COPY benchmarks_v5/resource-envelope-workloads-v1.yaml /app/benchmarks_v5/resource-envelope-workloads-v1.yaml

RUN useradd --create-home --uid 10001 benchmark
USER 10001:10001

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "-m", "evaluation_v5.resource.pod_runner"]
